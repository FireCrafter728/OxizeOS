namespace std
{
    // ---- //
    // MOVE //
    // ---- //

    template <typename T>
    constexpr T&& move(T& t) noexcept
    {
        return static_cast<T&&>(t);
    }

    // ------- //
    // FORWARD //
    // ------- //

    template <typename T>
    constexpr T&& forward(std::remove_reference_t<T>& t) noexcept
    {
        return static_cast<T&&>(t);
    }

    template <typename T>
    constexpr T&& forward(std::remove_reference_t<T>&& t) noexcept
    {
        return static_cast<T&&>(t);
    }
}