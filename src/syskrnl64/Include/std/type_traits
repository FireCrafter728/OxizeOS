namespace std
{
    // ----------------- //
    // INTEGRAL_CONSTANT //
    // ----------------- //

    template<typename T, T v>
    struct integral_constant
    {
        static constexpr T value = v;
        using value_type = T;
        using type = integral_constant;

        constexpr operator value_type() const noexcept { return value; }
        constexpr value_type operator()() const noexcept { return value; }
    };

    template<bool B>
    using bool_constant = integral_constant<bool, B>;
    
    using true_type = bool_constant<true>;
    using false_type = bool_constant<false>;

    // ---------------- //
    // REMOVE_REFERENCE //
    // ---------------- //

    template<class T> struct remove_reference { using type = T; };
    template<class T> struct remove_reference<T&> { using type = T; };
    template<class T> struct remove_reference<T&&> { using type = T; };

    template<class T>
    using remove_reference_t = typename remove_reference<T>::type;

    // ------- //
    // IS_SAME //
    // ------- //

    template<typename A, typename B>
    struct is_same : false_type {};

    template<typename A>
    struct is_same<A, A> : true_type {};

    template<typename A, typename B>
    inline constexpr bool is_same_v = is_same<A, B>::value;

    // ------------------------ //
    // IS_NOTHROW_CONSTRUCTIBLE //
    // ------------------------ //

    template<typename T, typename... _Args>
    struct is_nothrow_constructible 
    {
        static constexpr bool value = noexcept(T(static_cast<_Args&&>(*(_Args*)nullptr)...));
    };
    
    template<typename T, typename... _Args>
    inline constexpr bool is_nothrow_constructible_v = is_nothrow_constructible<T, _Args...>::value;
}