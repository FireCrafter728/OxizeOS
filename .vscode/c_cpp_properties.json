{
    "configurations": [
        {
            "name": "TskSchl",
            "includePath": [
                "${workspaceFolder}/src/tskschl/Include/",
                "${workspaceFolder}/lib/OxizeOS/"
            ],
            "compilerPath": "${workspaceFolder}/toolchain/x86_64-elf/bin/x86_64-elf-gcc",
            "cStandard": "c23",
            "cppStandard": "c++23",
            "intelliSenseMode": "linux-gcc-x64",
            "forcedInclude": [
                "${workspaceFolder}/src/tskschl/Include/Global.hpp"
            ]
        },
        {
            "name": "GPT",
            "includePath": [
                "${workspaceFolder}/tools/gpt/"
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c23",
            "cppStandard": "c++23",
            "intelliSenseMode": "linux-gcc-x64",
            "forcedInclude": [
                "${workspaceFolder}/tools/gpt/global.hpp"
            ],
            "compilerArgs": [
                "-fshort-wchar"
            ],
            "defines": [
                "__SIZEOF_WCHAR_T__=2"
            ]
        },
        {
            "name": "Image",
            "includePath": [
                "${workspaceFolder}/tools/Image/Include/"
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c23",
            "cppStandard": "c++23",
            "intelliSenseMode": "linux-gcc-x64",
            "forcedInclude": [
                "${workspaceFolder}/tools/Image/Include/Global.hpp"
            ]
        },
        {
            "name": "FAT32",
            "includePath": [
                "${workspaceFolder}/tools/fat/"
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c23",
            "cppStandard": "c++23",
            "intelliSenseMode": "linux-gcc-x64",
            "forcedInclude": [
                "${workspaceFolder}/tools/fat/global.hpp"
            ]
        }
    ],
    "version": 4
}